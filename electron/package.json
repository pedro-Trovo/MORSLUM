{
  "name": "morslum",
  "version": "1.0.0",
  "description": "MORSLUM - Analisador Morfossintático",
  "author": "Pedro Trovo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "br.edu.fatec.morslum",
    "productName": "MORSLUM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../back-end",
        "to": "back-end",
        "filter": ["**/*"]
      },
      {
        "from": "../python-embed",
        "to": "python-embed",
        "filter": ["**/*", "!**/*.pdb"]
      },
      {
        "from": "../front-end/dist",
        "to": "front-end",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  }
}